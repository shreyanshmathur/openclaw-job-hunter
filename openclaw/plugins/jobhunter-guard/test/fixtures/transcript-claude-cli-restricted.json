{
  "name": "claude-cli restricted runs: bridged OpenClaw tools of the onboarding and probe jobs",
  "note": "Shapes as OpenClaw 2026.9.8 hands bridged mcp__openclaw__* calls to plugin hooks (canonical tool names, ctx with agentId, sessionKey, sessionId, runId, workspaceDir; 9.8 exec calls carry a display `title`, as in the live jhtest run). Built from the 9.8 source; replaced by the redacted recordEvents output of the jhtest run (same file name). Fictional data only.",
  "config": {"protectedRoots": {"read": ["@REPO@/private", "@HOME@/.openclaw"], "write": ["@REPO@", "@WS@", "@HOME@/.openclaw"]}},
  "steps": [
    {"call": {"agent": "jobhunter-evaluator", "session": "agent:jobhunter-evaluator:cron:onboard-profile", "tool": "exec", "params": {"title": "Check agent identity", "command": "@JH@ whoami", "timeoutSeconds": 90}, "ctx": {"sessionId": "sess-ev-1", "runId": "run-ev-1", "workspaceDir": "@WS@/evaluator"}}, "expect": "allow", "expect_rewrite": {"rest": "whoami", "workdir": "@WS@/evaluator/work"}},
    {"env": {"agent": "jobhunter-evaluator", "session": "agent:jobhunter-evaluator:cron:onboard-profile", "runId": "run-ev-1"}, "expect_env": true},
    {"call": {"agent": "jobhunter-evaluator", "session": "agent:jobhunter-evaluator:cron:onboard-profile", "tool": "write", "params": {"path": "@WS@/evaluator/work/probe/ok.txt", "content": "OK"}, "ctx": {"sessionId": "sess-ev-1", "runId": "run-ev-1", "workspaceDir": "@WS@/evaluator"}}, "expect": "allow"},
    {"call": {"agent": "jobhunter-evaluator", "session": "agent:jobhunter-evaluator:cron:onboard-profile", "tool": "read", "params": {"path": "@WS@/evaluator/work/probe/ok.txt"}, "ctx": {"sessionId": "sess-ev-1", "runId": "run-ev-1", "workspaceDir": "@WS@/evaluator"}}, "expect": "allow"},
    {"call": {"agent": "jobhunter-evaluator", "session": "agent:jobhunter-evaluator:cron:onboard-profile", "tool": "read", "params": {"path": "@WS@/evaluator/ref/profile_inference.md"}, "ctx": {"sessionId": "sess-ev-1", "runId": "run-ev-1", "workspaceDir": "@WS@/evaluator"}}, "expect": "allow"},
    {"call": {"agent": "jobhunter-evaluator", "session": "agent:jobhunter-evaluator:cron:onboard-profile", "tool": "read", "params": {"path": "work/onboarding/profile_inputs.json"}, "ctx": {"sessionId": "sess-ev-1", "runId": "run-ev-1", "workspaceDir": "@WS@/evaluator"}}, "expect": "allow"},
    {"call": {"agent": "jobhunter-evaluator", "session": "agent:jobhunter-evaluator:cron:onboard-profile", "tool": "write", "params": {"path": "@WS@/evaluator/work/onboarding/profile_inference.json", "content": "{\"headline\": \"Data analyst\"}"}, "ctx": {"sessionId": "sess-ev-1", "runId": "run-ev-1", "workspaceDir": "@WS@/evaluator"}}, "expect": "allow"},
    {"call": {"agent": "jobhunter-evaluator", "session": "agent:jobhunter-evaluator:cron:onboard-profile", "tool": "exec", "params": {"command": "@JH@ profile infer-record --file @WS@/evaluator/work/onboarding/profile_inference.json"}, "ctx": {"sessionId": "sess-ev-1", "runId": "run-ev-1", "workspaceDir": "@WS@/evaluator"}}, "expect": "allow", "expect_rewrite": {"rest": "profile infer-record --file @WS@/evaluator/work/onboarding/profile_inference.json", "workdir": "@WS@/evaluator/work"}},
    {"call": {"agent": "jobhunter-evaluator", "session": "agent:jobhunter-evaluator:cron:onboard-profile", "tool": "mcp__openclaw__exec", "params": {"command": "@PY@ -I @REPO@/scripts/jh.py home show"}, "ctx": {"sessionId": "sess-ev-1", "runId": "run-ev-1", "workspaceDir": "@WS@/evaluator"}}, "expect": "allow", "expect_rewrite": {"rest": "home show", "workdir": "@WS@/evaluator/work"}},
    {"call": {"agent": "jobhunter-evaluator", "session": "agent:jobhunter-evaluator:cron:onboard-profile", "tool": "mcp__openclaw__exec", "params": {"title": "Record profile inference", "command": "@JH@ profile infer-record --file @WS@/evaluator/work/onboarding/profile_inference.json"}, "ctx": {"sessionId": "sess-ev-1", "runId": "run-ev-1", "workspaceDir": "@WS@/evaluator"}}, "expect": "allow", "expect_rewrite": {"rest": "profile infer-record --file @WS@/evaluator/work/onboarding/profile_inference.json", "workdir": "@WS@/evaluator/work"}},
    {"call": {"agent": "jobhunter-evaluator", "session": "agent:jobhunter-evaluator:cron:onboard-profile", "tool": "exec", "params": {"title": "List root", "command": "/bin/ls /"}, "ctx": {"sessionId": "sess-ev-1", "runId": "run-ev-1", "workspaceDir": "@WS@/evaluator"}}, "expect": "G_EXEC_SHAPE"},
    {"call": {"agent": "jobhunter-evaluator", "session": "agent:jobhunter-evaluator:cron:onboard-profile", "tool": "exec", "params": {"title": "Run dispatcher", "command": "@JH@ dispatch tick"}, "ctx": {"sessionId": "sess-ev-1", "runId": "run-ev-1", "workspaceDir": "@WS@/evaluator"}}, "expect": "G_EXEC_ACL"},
    {"call": {"agent": "jobhunter-evaluator", "session": "agent:jobhunter-evaluator:cron:onboard-profile", "tool": "exec", "params": {"title": "Show home", "command": "@JH@ home show", "env": {"JH_AGENT_ID": "jobhunter-scout"}}, "ctx": {"sessionId": "sess-ev-1", "runId": "run-ev-1", "workspaceDir": "@WS@/evaluator"}}, "expect": "G_EXEC_SHAPE"},
    {"call": {"agent": "jobhunter-evaluator", "session": "agent:jobhunter-evaluator:cron:onboard-profile", "tool": "exec", "params": {"title": "Show home", "command": "@JH@ home show", "elevated": true}, "ctx": {"sessionId": "sess-ev-1", "runId": "run-ev-1", "workspaceDir": "@WS@/evaluator"}}, "expect": "G_EXEC_SHAPE"},
    {"call": {"agent": "jobhunter-evaluator", "session": "agent:jobhunter-evaluator:cron:onboard-profile", "tool": "exec", "params": {"title": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx", "command": "@JH@ home show"}, "ctx": {"sessionId": "sess-ev-1", "runId": "run-ev-1", "workspaceDir": "@WS@/evaluator"}}, "expect": "G_EXEC_SHAPE"},
    {"call": {"agent": "jobhunter-evaluator", "session": "agent:jobhunter-evaluator:cron:onboard-profile", "tool": "exec", "params": {"title": "Show home\nthen more", "command": "@JH@ home show"}, "ctx": {"sessionId": "sess-ev-1", "runId": "run-ev-1", "workspaceDir": "@WS@/evaluator"}}, "expect": "G_EXEC_SHAPE"},
    {"call": {"agent": "jobhunter-evaluator", "session": "agent:jobhunter-evaluator:cron:onboard-profile", "tool": "exec", "params": {"command": "@PY@ -I @REPO@/scripts/jh.py --agent-proof jhp2.jobhunter-evaluator.1790000000.0123456789abcdef.0123456789abcdef.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa profile infer-record --file @WS@/evaluator/work/onboarding/profile_inference.json"}, "ctx": {"sessionId": "sess-ev-1", "runId": "run-ev-1", "workspaceDir": "@WS@/evaluator"}}, "expect": "G_EXEC_PARAM"},
    {"call": {"agent": "jobhunter-evaluator", "session": "agent:jobhunter-evaluator:cron:onboard-profile", "tool": "exec", "params": {"command": "@JH@ approve A7K2 --by chat"}, "ctx": {"sessionId": "sess-ev-1", "runId": "run-ev-1", "workspaceDir": "@WS@/evaluator"}}, "expect": "G_EXEC_ACL"},
    {"call": {"agent": "jobhunter-evaluator", "session": "agent:jobhunter-evaluator:cron:onboard-profile", "tool": "exec", "params": {"command": "cat @REPO@/private/home.json"}, "ctx": {"sessionId": "sess-ev-1", "runId": "run-ev-1", "workspaceDir": "@WS@/evaluator"}}, "expect": "G_EXEC_SHAPE"},
    {"call": {"agent": "jobhunter-evaluator", "session": "agent:jobhunter-evaluator:cron:onboard-profile", "tool": "exec", "params": {"command": "@JH@ home show", "env": {"PYTHONPATH": "/tmp"}}, "ctx": {"sessionId": "sess-ev-1", "runId": "run-ev-1", "workspaceDir": "@WS@/evaluator"}}, "expect": "G_EXEC_SHAPE"},
    {"call": {"agent": "jobhunter-evaluator", "session": "agent:jobhunter-evaluator:cron:onboard-profile", "tool": "exec", "params": {"command": "@JH@ home show", "elevated": true}, "ctx": {"sessionId": "sess-ev-1", "runId": "run-ev-1", "workspaceDir": "@WS@/evaluator"}}, "expect": "G_EXEC_SHAPE"},
    {"call": {"agent": "jobhunter-evaluator", "session": "agent:jobhunter-evaluator:cron:onboard-profile", "tool": "read", "params": {"path": "~/.ssh/id_ed25519"}, "ctx": {"sessionId": "sess-ev-1", "runId": "run-ev-1", "workspaceDir": "@WS@/evaluator"}}, "expect": "G_PATH_DENIED"},
    {"call": {"agent": "jobhunter-evaluator", "session": "agent:jobhunter-evaluator:cron:onboard-profile", "tool": "read", "params": {"path": "@../scout/AGENTS.md"}, "ctx": {"sessionId": "sess-ev-1", "runId": "run-ev-1", "workspaceDir": "@WS@/evaluator"}}, "expect": "G_PATH_DENIED"},
    {"call": {"agent": "jobhunter-evaluator", "session": "agent:jobhunter-evaluator:cron:onboard-profile", "tool": "read", "params": {"path": "node://mac/etc/hosts"}, "ctx": {"sessionId": "sess-ev-1", "runId": "run-ev-1", "workspaceDir": "@WS@/evaluator"}}, "expect": "G_PATH_DENIED"},
    {"call": {"agent": "jobhunter-evaluator", "session": "agent:jobhunter-evaluator:cron:onboard-profile", "tool": "read", "params": {"path": "@REPO@/private/guard.key"}, "ctx": {"sessionId": "sess-ev-1", "runId": "run-ev-1", "workspaceDir": "@WS@/evaluator"}}, "expect": "G_PATH_DENIED"},
    {"call": {"agent": "jobhunter-evaluator", "session": "agent:jobhunter-evaluator:cron:onboard-profile", "tool": "read", "params": {"path": "@WS@/scout/work/onboarding/salary_inputs.json"}, "ctx": {"sessionId": "sess-ev-1", "runId": "run-ev-1", "workspaceDir": "@WS@/evaluator"}}, "expect": "G_PATH_DENIED"},
    {"call": {"agent": "jobhunter-evaluator", "session": "agent:jobhunter-evaluator:cron:onboard-profile", "tool": "write", "params": {"path": "@WS@/evaluator/AGENTS.md", "content": "x"}, "ctx": {"sessionId": "sess-ev-1", "runId": "run-ev-1", "workspaceDir": "@WS@/evaluator"}}, "expect": "G_PATH_DENIED"},
    {"call": {"agent": "jobhunter-evaluator", "session": "agent:jobhunter-evaluator:cron:onboard-profile", "tool": "write", "params": {"path": "@WS@/evaluator/work/.mcp.json", "content": "{}"}, "ctx": {"sessionId": "sess-ev-1", "runId": "run-ev-1", "workspaceDir": "@WS@/evaluator"}}, "expect": "G_PATH_DENIED"},
    {"call": {"agent": "jobhunter-evaluator", "session": "agent:jobhunter-evaluator:cron:onboard-profile", "tool": "edit", "params": {"path": "@WS@/evaluator/work/onboarding/profile_inference.json", "edits": [{"oldText": "a", "newText": "b"}]}, "ctx": {"sessionId": "sess-ev-1", "runId": "run-ev-1", "workspaceDir": "@WS@/evaluator"}}, "expect": "G_TOOL_DENIED"},
    {"call": {"agent": "jobhunter-evaluator", "session": "agent:jobhunter-evaluator:cron:onboard-profile", "tool": "apply_patch", "params": {"input": "*** Begin Patch\n*** Add File: work/x.txt\n+x\n*** End Patch"}, "ctx": {"sessionId": "sess-ev-1", "runId": "run-ev-1", "workspaceDir": "@WS@/evaluator"}}, "expect": "G_TOOL_DENIED"},
    {"call": {"agent": "jobhunter-evaluator", "session": "agent:jobhunter-evaluator:cron:onboard-profile", "tool": "browser", "params": {"profile": "jobhunter", "action": "tabs"}, "ctx": {"sessionId": "sess-ev-1", "runId": "run-ev-1", "workspaceDir": "@WS@/evaluator"}}, "expect": "G_TOOL_DENIED"},
    {"call": {"agent": "jobhunter-evaluator", "session": "agent:jobhunter-evaluator:cron:onboard-profile", "tool": "cron", "params": {"action": "list"}, "ctx": {"sessionId": "sess-ev-1", "runId": "run-ev-1", "workspaceDir": "@WS@/evaluator"}}, "expect": "G_TOOL_DENIED"},
    {"call": {"agent": "jobhunter-scout", "session": "agent:jobhunter-scout:cron:onboard-salary", "tool": "read", "params": {"path": "@WS@/scout/work/onboarding/salary_inputs.json"}, "ctx": {"sessionId": "sess-sc-1", "runId": "run-sc-1", "workspaceDir": "@WS@/scout"}}, "expect": "allow"},
    {"call": {"agent": "jobhunter-scout", "session": "agent:jobhunter-scout:cron:onboard-salary", "tool": "browser", "params": {"action": "navigate", "targetUrl": "https://www.naukri.com/data-analyst-jobs"}, "ctx": {"sessionId": "sess-sc-1", "runId": "run-sc-1", "workspaceDir": "@WS@/scout"}}, "expect": "G_BROWSER_PROFILE"},
    {"call": {"agent": "jobhunter-scout", "session": "agent:jobhunter-scout:cron:onboard-salary", "tool": "browser", "params": {"profile": "openclaw", "action": "navigate", "targetUrl": "https://www.naukri.com/data-analyst-jobs"}, "ctx": {"sessionId": "sess-sc-1", "runId": "run-sc-1", "workspaceDir": "@WS@/scout"}}, "expect": "G_BROWSER_PROFILE"},
    {"call": {"agent": "jobhunter-scout", "session": "agent:jobhunter-scout:cron:onboard-salary", "tool": "browser", "params": {"profile": "jobhunter", "action": "navigate", "targetUrl": "https://www.naukri.com/data-analyst-jobs"}, "ctx": {"sessionId": "sess-sc-1", "runId": "run-sc-1", "workspaceDir": "@WS@/scout"}}, "expect": "allow"},
    {"call": {"agent": "jobhunter-scout", "session": "agent:jobhunter-scout:cron:onboard-salary", "tool": "write", "params": {"path": "@WS@/scout/work/onboarding/salary.json", "content": "{\"band\": \"example\"}"}, "ctx": {"sessionId": "sess-sc-1", "runId": "run-sc-1", "workspaceDir": "@WS@/scout"}}, "expect": "allow"},
    {"call": {"agent": "jobhunter-scout", "session": "agent:jobhunter-scout:cron:onboard-salary", "tool": "exec", "params": {"command": "@JH@ profile salary-record --file @WS@/scout/work/onboarding/salary.json"}, "ctx": {"sessionId": "sess-sc-1", "runId": "run-sc-1", "workspaceDir": "@WS@/scout"}}, "expect": "allow", "expect_rewrite": {"rest": "profile salary-record --file @WS@/scout/work/onboarding/salary.json", "workdir": "@WS@/scout/work"}},
    {"call": {"agent": "jobhunter-scout", "session": "agent:jobhunter-scout:cron:onboard-salary", "tool": "exec", "params": {"command": "@JH@ profile infer-record --file @WS@/scout/work/onboarding/salary.json"}, "ctx": {"sessionId": "sess-sc-1", "runId": "run-sc-1", "workspaceDir": "@WS@/scout"}}, "expect": "G_EXEC_ACL"},
    {"call": {"agent": "jobhunter-scout", "session": "agent:jobhunter-scout:cron:onboard-salary", "tool": "read", "params": {"path": "notes.md"}, "ctx": {"workspaceDir": "@WS@/evaluator"}}, "expect": "G_PATH_DENIED"},
    {"call": {"agent": "main", "session": "agent:main:main", "tool": "cron", "params": {"action": "add", "job": {"agentId": "jobhunter-evaluator", "message": "run profile inference"}}, "ctx": {"workspaceDir": "@HOME@/.openclaw/workspace"}}, "expect": "G_OTHER_AGENT_DENIED"},
    {"call": {"agent": "main", "session": "agent:main:main", "tool": "sessions_send", "params": {"sessionKey": "agent:jobhunter-evaluator:cron:onboard-profile", "message": "hi"}}, "expect": "G_OTHER_AGENT_DENIED"},
    {"call": {"agent": "main", "session": "agent:main:main", "tool": "read", "params": {"path": "@REPO@/private/home.json"}}, "expect": "G_PATH_DENIED"},
    {"call": {"agent": "main", "session": "agent:main:main", "tool": "exec", "params": {"command": "@JH@ status"}}, "expect": "pass"},
    {"call": {"agent": "main", "session": "agent:main:main", "tool": "read", "params": {"path": "@HOME@/.openclaw/openclaw.json"}, "ctx": {"workspaceDir": "@HOME@/.openclaw/workspace"}}, "expect": "G_PATH_DENIED"},
    {"call": {"agent": "main", "session": "agent:main:main", "tool": "read", "params": {"path": "notes.md"}, "ctx": {"workspaceDir": "@HOME@/.openclaw/workspace"}}, "expect": "pass"},
    {"call": {"agent": "main", "session": "agent:main:main", "tool": "write", "params": {"path": "@WS@/evaluator/work/onboarding/profile_inference.json", "content": "{}"}, "ctx": {"workspaceDir": "@HOME@/.openclaw/workspace"}}, "expect": "G_PATH_DENIED"},
    {"env": {"agent": "main", "session": "agent:main:main", "runId": "r"}, "expect_env": false}
  ]
}
