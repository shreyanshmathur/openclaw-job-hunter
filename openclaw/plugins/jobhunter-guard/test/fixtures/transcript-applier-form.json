{
  "name": "applier fills and submits one ATS form under a token",
  "steps": [
    {"call": {"agent": "jobhunter-applier", "session": "s-app", "tool": "browser", "params": {"profile": "jobhunter", "action": "navigate", "targetUrl": "https://job-boards.greenhouse.io/kestrel/jobs/4000001"}}, "expect": "allow"},
    {"result": {"agent": "jobhunter-applier", "session": "s-app", "tool": "browser", "params": {"profile": "jobhunter", "action": "navigate", "targetUrl": "https://job-boards.greenhouse.io/kestrel/jobs/4000001"},
      "result": {"content": [{"type": "text", "text": "- main:\n  - heading \"Data Analyst\" [level=1]\n  - textbox \"First Name\" [ref=e4]\n  - button \"Attach\" [ref=e8]\n  - button \"Submit application\" [ref=e6]"}], "details": {"ok": true, "targetId": "t9", "url": "https://job-boards.greenhouse.io/kestrel/jobs/4000001"}}}, "expect_stop": false},
    {"call": {"agent": "jobhunter-applier", "session": "s-app", "tool": "browser", "params": {"profile": "jobhunter", "action": "act", "kind": "type", "ref": "e4", "text": "Alex", "slowly": true}}, "expect": "G_NO_TOKEN"},
