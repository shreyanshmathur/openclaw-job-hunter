{
  "name": "claude-cli unrestricted run: Claude Code native tools as OpenClaw projects them for plugin hooks",
  "note": "Shapes of execute-plugin.ts in OpenClaw 2026.9.8: native Bash -> exec {command, description, timeout}; native Read/Write/Edit -> read/write/edit with path = file_path; ctx with agentId, sessionKey, cwd, workspaceDir. Deny mode refuses every native call of a jobhunter agent; gate mode (mode N) judges them. Fictional data only.",
  "config": {"protectedRoots": {"read": ["@REPO@/private", "@HOME@/.openclaw"], "write": ["@REPO@", "@WS@", "@HOME@/.openclaw"]}},
  "steps": [
    {"call": {"agent": "jobhunter-evaluator", "session": "agent:jobhunter-evaluator:main", "tool": "exec", "params": {"command": "@JH@ home show", "description": "Show the install", "timeout": 120000}, "ctx": {"cwd": "@WS@/evaluator", "workspaceDir": "@WS@/evaluator"}}, "expect": "G_TOOL_DENIED"},
    {"call": {"agent": "jobhunter-evaluator", "session": "agent:jobhunter-evaluator:main", "tool": "read", "params": {"file_path": "@WS@/evaluator/ref/profile_inference.md", "path": "@WS@/evaluator/ref/profile_inference.md"}, "ctx": {"cwd": "@WS@/evaluator", "workspaceDir": "@WS@/evaluator"}}, "expect": "G_TOOL_DENIED"},
    {"call": {"agent": "jobhunter-evaluator", "session": "agent:jobhunter-evaluator:main", "tool": "write", "params": {"file_path": "@WS@/evaluator/work/a.json", "path": "@WS@/evaluator/work/a.json", "content": "{}"}, "ctx": {"cwd": "@WS@/evaluator", "workspaceDir": "@WS@/evaluator"}}, "expect": "G_TOOL_DENIED"},
    {"call": {"agent": "jobhunter-evaluator", "session": "agent:jobhunter-evaluator:main", "tool": "edit", "params": {"file_path": "@WS@/evaluator/work/a.json", "path": "@WS@/evaluator/work/a.json", "old_string": "a", "new_string": "b", "edits": [{"oldText": "a", "newText": "b"}]}, "ctx": {"cwd": "@WS@/evaluator"}}, "expect": "G_TOOL_DENIED"},
    {"call": {"agent": "jobhunter-evaluator", "session": "agent:jobhunter-evaluator:main", "tool": "Glob", "params": {"pattern": "**/*.md"}, "ctx": {"cwd": "@WS@/evaluator"}}, "expect": "G_TOOL_DENIED"},
    {"call": {"agent": "jobhunter-evaluator", "session": "agent:jobhunter-evaluator:main", "tool": "Grep", "params": {"pattern": "salary", "path": "@WS@/evaluator"}, "ctx": {"cwd": "@WS@/evaluator"}}, "expect": "G_TOOL_DENIED"},
    {"call": {"agent": "jobhunter-evaluator", "session": "agent:jobhunter-evaluator:main", "tool": "WebFetch", "params": {"url": "https://kestrel.example/careers", "prompt": "list roles"}}, "expect": "G_TOOL_DENIED"},
    {"call": {"agent": "jobhunter-evaluator", "session": "agent:jobhunter-evaluator:main", "tool": "TodoWrite", "params": {"todos": [{"content": "x", "status": "pending"}]}}, "expect": "G_TOOL_DENIED"},
    {"call": {"agent": "jobhunter-evaluator", "session": "agent:jobhunter-evaluator:main", "tool": "Bash", "params": {"command": "@JH@ home show"}}, "expect": "G_TOOL_DENIED"},
    {"expect_log": {"kind": "native_tool", "count": 9}},
    {"call": {"agent": "jobhunter-evaluator", "session": "agent:jobhunter-evaluator:main", "tool": "exec", "params": {"command": "@JH@ home show", "description": "Show the install", "timeout": 120000}, "ctx": {"cwd": "@WS@/evaluator", "workspaceDir": "@WS@/evaluator"}}, "expect": "allow", "mode": "gate", "expect_rewrite": {"rest": "home show", "timeout": 90000}},
    {"call": {"agent": "jobhunter-evaluator", "session": "agent:jobhunter-evaluator:main", "tool": "exec", "params": {"command": "@JH@ home show", "run_in_background": true}, "ctx": {"cwd": "@WS@/evaluator"}}, "expect": "G_EXEC_SHAPE", "mode": "gate"},
    {"call": {"agent": "jobhunter-evaluator", "session": "agent:jobhunter-evaluator:main", "tool": "exec", "params": {"command": "cat /etc/hosts", "timeout": 1000}, "ctx": {"cwd": "@WS@/evaluator"}}, "expect": "G_EXEC_SHAPE", "mode": "gate"},
    {"call": {"agent": "jobhunter-evaluator", "session": "agent:jobhunter-evaluator:main", "tool": "read", "params": {"file_path": "@WS@/evaluator/ref/profile_inference.md", "path": "@WS@/evaluator/ref/profile_inference.md"}, "ctx": {"cwd": "@WS@/evaluator", "workspaceDir": "@WS@/evaluator"}}, "expect": "allow", "mode": "gate"},
    {"call": {"agent": "jobhunter-evaluator", "session": "agent:jobhunter-evaluator:main", "tool": "read", "params": {"file_path": "~/.zshrc", "path": "~/.zshrc"}, "ctx": {"cwd": "@WS@/evaluator", "workspaceDir": "@WS@/evaluator"}}, "expect": "G_PATH_DENIED", "mode": "gate"},
    {"call": {"agent": "jobhunter-evaluator", "session": "agent:jobhunter-evaluator:main", "tool": "write", "params": {"file_path": "@WS@/evaluator/work/CLAUDE.md", "path": "@WS@/evaluator/work/CLAUDE.md", "content": "x"}, "ctx": {"cwd": "@WS@/evaluator", "workspaceDir": "@WS@/evaluator"}}, "expect": "G_PATH_DENIED", "mode": "gate"},
    {"call": {"agent": "jobhunter-evaluator", "session": "agent:jobhunter-evaluator:main", "tool": "edit", "params": {"file_path": "@WS@/evaluator/work/a.json", "path": "@WS@/evaluator/work/a.json", "old_string": "a", "new_string": "b"}, "ctx": {"cwd": "@WS@/evaluator"}}, "expect": "G_TOOL_DENIED", "mode": "gate"},
    {"call": {"agent": "main", "session": "agent:main:main", "tool": "exec", "params": {"command": "@JH@ status", "description": "status", "timeout": 30000}, "ctx": {"cwd": "@HOME@/.openclaw/workspace", "workspaceDir": "@HOME@/.openclaw/workspace"}}, "expect": "pass"},
    {"call": {"agent": "main", "session": "agent:main:main", "tool": "exec", "params": {"command": "@JH@ approve A7K2 --by chat", "timeout": 30000}, "ctx": {"cwd": "@HOME@/.openclaw/workspace"}}, "expect": "G_EXEC_ACL"},
    {"call": {"agent": "main", "session": "agent:main:main", "tool": "read", "params": {"file_path": "@REPO@/private/home.json", "path": "@REPO@/private/home.json"}, "ctx": {"cwd": "@HOME@/.openclaw/workspace"}}, "expect": "G_PATH_DENIED"},
    {"call": {"agent": "main", "session": "agent:main:main", "tool": "exec", "params": {"command": "openclaw agent --agent jobhunter-scout --message hello", "timeout": 30000}, "ctx": {"cwd": "@HOME@/.openclaw/workspace"}}, "expect": "G_OTHER_AGENT_DENIED"},
    {"call": {"agent": "main", "session": "agent:main:main", "tool": "read", "params": {"file_path": "@HOME@/.openclaw/workspace/notes.md", "path": "@HOME@/.openclaw/workspace/notes.md"}, "ctx": {"cwd": "@HOME@/.openclaw/workspace", "workspaceDir": "@HOME@/.openclaw/workspace"}}, "expect": "pass"},
    {"call": {"agent": "main", "session": "agent:main:main", "tool": "read", "params": {"file_path": "@HOME@/.openclaw/openclaw.json", "path": "@HOME@/.openclaw/openclaw.json"}, "ctx": {"cwd": "@HOME@/.openclaw/workspace", "workspaceDir": "@HOME@/.openclaw/workspace"}}, "expect": "G_PATH_DENIED"},
    {"call": {"agent": "main", "session": "agent:main:main", "tool": "exec", "params": {"command": "cat ../openclaw.json", "timeout": 30000}, "ctx": {"cwd": "@HOME@/.openclaw/workspace", "workspaceDir": "@HOME@/.openclaw/workspace"}}, "expect": "G_PATH_DENIED"}
  ]
}
