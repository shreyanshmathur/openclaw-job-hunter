// Exec approvals entries for the jobhunter agents (design 10.3 step 9; default, not optional).
//
// `jh.py install render-approvals --current <approvals get --json output>` merges one entry per jobhunter
// agent into the "agents" map of the host approvals document and writes state/install/approvals.json, which
// install.sh uploads with `openclaw approvals set --file`. "defaults" and every other agent are kept exactly
// as they were. uninstall.sh runs the same command with --remove.
//
// __PY__ is the absolute python3 path from private/home.json. __ARG_PATTERN__ is rendered by code
// (jobhunter.install.arg_pattern): ^<repo, regex escaped>/scripts/jh\.py( --cycle C[0-9A-Z]+)?( --quiet)?
// followed by any command that is not human-only (jobhunter.install.HUMAN_ONLY_WORDS: approvals, PIN changes,
// limits, the email finder's connect, disconnect, retry, test and find --include-reserve, and every install
// helper, among them the browser consent record and revoke).
{
  // agents whose tools include exec
  "exec_agent": {
    "security": "allowlist",
    "ask": "on-miss",
    "askFallback": "deny",
    "allowlist": [
      {"pattern": "__PY__", "argPattern": "__ARG_PATTERN__"}
    ]
  },
  // agents without exec (jobhunter-qc)
  "no_exec_agent": {
    "security": "deny",
    "ask": "off",
    "askFallback": "deny",
    "allowlist": []
  }
}
