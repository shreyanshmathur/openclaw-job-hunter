{
  "version": 2,
  "jobs": [
    {"key": "jobhunter:dispatch", "name": "jobhunter-dispatch", "display": "Job Hunter: dispatcher", "kind": "command",
     "schedule": {"every": "10m"}, "argv": ["{PY}", "{REPO}/scripts/jh.py", "dispatch", "tick", "--quiet"],
     "timeout_s": 120, "no_output_timeout_s": 100, "enable_on_resume": true, "failure_alert": true},
    {"key": "jobhunter:sources-api", "name": "jobhunter-sources-api", "display": "Job Hunter: fetch job APIs", "kind": "command",
     "schedule": {"cron": "15 */6 * * *"}, "argv": ["{PY}", "{REPO}/scripts/jh.py", "sources", "fetch", "--lane", "api", "--quiet"],
     "timeout_s": 900, "no_output_timeout_s": 300, "enable_on_resume": true, "failure_alert": false},
    {"key": "jobhunter:mailer", "name": "jobhunter-mailer", "display": "Job Hunter: send approved email", "kind": "command",
     "schedule": {"every": "5m"}, "argv": ["{PY}", "{REPO}/scripts/jh.py", "mail", "run", "--quiet"],
     "timeout_s": 150, "no_output_timeout_s": 120, "enable_on_resume": true, "failure_alert": true},
    {"key": "jobhunter:qc-worker", "name": "jobhunter-qc-worker", "display": "Job Hunter: QC reviews", "kind": "command",
     "schedule": {"every": "5m"}, "argv": ["{PY}", "{REPO}/scripts/jh.py", "qc", "worker", "--drain", "--max-seconds", "250", "--quiet"],
     "timeout_s": 300, "no_output_timeout_s": 280, "enable_on_resume": true, "failure_alert": true},
    {"key": "jobhunter:sheet-sync", "name": "jobhunter-sheet-sync", "display": "Job Hunter: Google Sheet sync", "kind": "command",
     "schedule": {"every": "20m"}, "argv": ["{PY}", "{REPO}/scripts/jh.py", "sheet", "sync", "--quiet"],
     "timeout_s": 180, "no_output_timeout_s": 120, "enable_on_resume": true, "failure_alert": false, "keep_running_when_paused": true},
    {"key": "jobhunter:notify", "name": "jobhunter-notify", "display": "Job Hunter: messages to you", "kind": "command",
     "schedule": {"every": "5m"}, "argv": ["{PY}", "{REPO}/scripts/jh.py", "notify", "flush", "--deliver", "--quiet"],
     "timeout_s": 120, "no_output_timeout_s": 100, "enable_on_resume": true, "failure_alert": true, "keep_running_when_paused": true},
    {"key": "jobhunter:digest", "name": "jobhunter-digest", "display": "Job Hunter: daily digest", "kind": "command",
     "schedule": {"cron": "0 9,19 * * *"}, "argv": ["{PY}", "{REPO}/scripts/jh.py", "digest", "--since-last", "--deliver", "--quiet"],
     "timeout_s": 120, "no_output_timeout_s": 100, "enable_on_resume": true, "failure_alert": false, "keep_running_when_paused": true},
    {"key": "jobhunter:housekeeping", "name": "jobhunter-housekeeping", "display": "Job Hunter: nightly housekeeping and audit", "kind": "command",
     "schedule": {"cron": "10 3 * * *"}, "argv": ["{PY}", "{REPO}/scripts/jh.py", "housekeeping", "--quiet"],
     "timeout_s": 900, "no_output_timeout_s": 600, "enable_on_resume": true, "failure_alert": true, "keep_running_when_paused": true},
    {"key": "jobhunter:scout", "name": "jobhunter-scout", "display": "Job Hunter: browse job sites", "kind": "agent",
     "agent": "jobhunter-scout", "tools": "exec,read,write,browser", "model": "anthropic/claude-sonnet-5", "fallbacks": "",
     "thinking": "low", "timeout_s": 1500, "schedule": {"cron": "0 0 1 1 *"},
     "message": "Run exactly one scout cycle as defined in AGENTS.md. First command: {PY} {REPO}/scripts/jh.py preflight --lane scout"},
    {"key": "jobhunter:evaluate", "name": "jobhunter-evaluate", "display": "Job Hunter: evaluate jobs", "kind": "agent",
     "agent": "jobhunter-evaluator", "tools": "exec,read,write", "model": "anthropic/claude-sonnet-5", "fallbacks": "",
     "thinking": "medium", "timeout_s": 1200, "schedule": {"cron": "0 0 1 1 *"},
     "message": "Run exactly one evaluator cycle as defined in AGENTS.md. First command: {PY} {REPO}/scripts/jh.py preflight --lane evaluator"},
    {"key": "jobhunter:apply", "name": "jobhunter-apply", "display": "Job Hunter: apply", "kind": "agent",
     "agent": "jobhunter-applier", "tools": "exec,read,write,browser", "model": "anthropic/claude-opus-5-5",
     "fallbacks": "anthropic/claude-sonnet-5", "thinking": "medium", "timeout_s": 1800, "schedule": {"cron": "0 0 1 1 *"},
     "message": "Run exactly one applier cycle as defined in AGENTS.md. First command: {PY} {REPO}/scripts/jh.py preflight --lane applier"},
    {"key": "jobhunter:outreach", "name": "jobhunter-outreach", "display": "Job Hunter: outreach", "kind": "agent",
     "agent": "jobhunter-outreach", "tools": "exec,read,write,browser", "model": "anthropic/claude-opus-5-5",
     "fallbacks": "anthropic/claude-sonnet-5", "thinking": "medium", "timeout_s": 1800, "schedule": {"cron": "0 0 1 1 *"},
     "message": "Run exactly one outreach cycle as defined in AGENTS.md. First command: {PY} {REPO}/scripts/jh.py preflight --lane outreach"},
    {"key": "jobhunter:replies", "name": "jobhunter-replies", "display": "Job Hunter: replies and checks", "kind": "agent",
     "agent": "jobhunter-outreach", "tools": "exec,read,write,browser", "model": "anthropic/claude-sonnet-5", "fallbacks": "",
     "thinking": "low", "timeout_s": 900, "schedule": {"cron": "0 0 1 1 *"},
     "message": "Run exactly one replies cycle (no sending) as defined in AGENTS.md. First command: {PY} {REPO}/scripts/jh.py preflight --lane replies"}
  ]
}
