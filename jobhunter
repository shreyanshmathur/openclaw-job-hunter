red_line() { if [ -t 1 ]; then printf '\033[31m%s\033[0m\n' "$*"; else printf '%s\n' "$*"; fi; }

cmd_doctor() {
  need_home
  local bad=0 out="" probe=0
  case "${1:-}" in
    "") ;;
    --probe) probe=1 ;;
    *) die "usage: ./jobhunter doctor [--probe]" ;;
  esac
  check() {  # check <label> <command...>
    local label="$1"; shift
    if out="$("$@" 2>&1)"; then say "ok    $label"; else say "FAIL  $label"; printf '%s\n' "$out" | sed -n '1,6p' | sed 's/^/      /'; bad=1; fi
  }
  check "jh.py selftest" "$PY" "$JH" --human selftest
  check "config validate" "$PY" "$JH" --human config validate
  check "guard heartbeat (identity proof version 2)" "$PY" "$JH" --human install wait-guard --timeout 0 --proof-version 2
  # informational: OpenClaw 2026.9.8 blocks the guard's before_prompt_build hook without allowConversationAccess,
  # which the installer never grants (docs/ENFORCEMENT.md); the line says so, it never fails the doctor
  out="$("$PY" "$JH" --human install pin-hook 2>/dev/null || true)"
  case "$out" in ok\ *|WARN*|info*) say "$out" ;; esac
  check "exec policy of the jobhunter agents (allowlist, never ask)" "$PY" "$JH" --human install verify-exec-policy
  check "no automation outside this install runs a jobhunter agent" "$PY" "$JH" --human install foreign-jobs --check
  if [ "${JH_MODEL_ROUTE:-}" = "cli" ]; then
    if command -v claude >/dev/null 2>&1 && claude auth status --text >/dev/null 2>&1; then
      say "ok    Claude login (your Claude subscription)"
    else
      say "FAIL  Claude login: Claude Code is missing or its login expired. Run: claude auth login (opens your"
      say "      browser), check with: claude auth status --text, then ./jobhunter doctor again"
      bad=1
    fi
  fi
  local mode="" line=""
  mode="$("$PY" "$JH" --human install cli-route get cli_tools 2>/dev/null || true)"
  if [ "$mode" = "native" ]; then
    red_line "FAIL  agent mode: Claude Code's own tools (reduced protection). The exec allowlist and workspaceOnly do"
    red_line "      not apply to them and AskUserQuestion can wait. Run ./install.sh without --cli-tools for full protection."
  else
    say "ok    agent mode: restricted runs (Claude Code's own tools are off for the jobhunter agents)"
  fi
  out="$("$PY" "$JH" --human install probe-stamp read 2>/dev/null || true)"
  case "$out" in
    "last passed "*) say "info  agent identity checks: $out (./jobhunter doctor --probe runs them now)" ;;
    *) say "WARN  the agent identity checks have not passed yet: ./jobhunter doctor --probe runs them (if"
       say "      ./install.sh stopped at step 14, see docs/TROUBLESHOOTING.md, Claude subscription route)" ;;
  esac
  out="$("$PY" "$JH" --human install identity-boundary 2>/dev/null || true)"
  if [ -n "$out" ]; then
    while IFS= read -r line; do [ -z "$line" ] || red_line "RED   $line"; done <<EOF
$out
EOF
    say "      Agent identity cannot be forged by an agent whose shell is confined. An agent with an unconfined"
    say "      shell runs as you and is trusted like you."
  fi
  if [ "$probe" = "1" ]; then
    local t0="" role="" id=""
    t0="$(date +%s)"
    for role in scout evaluator applier outreach; do
      if id="$("$PY" "$JH" --human install run-preflight "jobhunter:probe-$role" 2>&1)"; then
        oc cron run "$id" --wait --wait-timeout 10m --json >/dev/null 2>&1 || true
      else
        say "FAIL  probe $role: $id"; bad=1
      fi
    done
    check "agent identity (scout, evaluator, applier and outreach ran jh.py as themselves)" \
      "$PY" "$JH" --human selftest --offline --probe-since "$t0"
    check "jobhunter-qc test turn" "$PY" "$JH" --human qc smoke
  fi
  # OpenClaw 2026.9.8 reports ok false for warnings only: jh.py judges the findings by severity (errors fail,
  # warnings are shown, the jobhunter agents' skill-workshop-tool-policy finding is expected)
  local drc=0 dout=""
  tmpdir
  oc doctor --lint --json >"$TMPD/oc-doctor.json" 2>"$TMPD/oc-doctor.err" || drc=$?
  if dout="$("$PY" "$JH" --human install oc-doctor --file "$TMPD/oc-doctor.json" \
      --stderr-file "$TMPD/oc-doctor.err" --rc "$drc" 2>&1)"; then
    say "ok    openclaw doctor (read only)"
  else
    say "FAIL  openclaw doctor (read only)"; bad=1
  fi
  [ -z "$dout" ] || printf '%s\n' "$dout" | sed -n '1,12p' | sed 's/^/      /'
  check "openclaw skills check" oc skills check --agent jobhunter-applier
  check "browser profile jobhunter" oc browser --browser-profile jobhunter doctor
  if [ "$(uname -s)" != "Darwin" ] && [ -z "${DISPLAY:-}" ] && [ -z "${WAYLAND_DISPLAY:-}" ]; then
    say "WARN  no display: browser lanes stay off on this host"
  fi
  local mstate=""
  mstate="$("$PY" "$JH" --human install mail-state 2>/dev/null)" || mstate=""
  case "$mstate" in
    *route=web_ui*)
      if site_allowed gmail; then say "skip  mail test (gmail.route is web_ui: Gmail in the agent's browser sends email)"
      else say "WARN  email is off: gmail.route is web_ui and Gmail is not allowed (./jobhunter browser consent gmail)"; fi ;;
    *connected=1*) check "mail test" "$PY" "$JH" --human mail test ;;
    *) say "skip  mail test (email is not connected yet: ./jobhunter mail connect)" ;;
  esac
  check "sheet ping" "$PY" "$JH" --human sheet ping
  local allowed="" site="" status="" rest=""
  while IFS="$TAB" read -r site status rest; do
    if [ "$status" = "granted" ]; then allowed="${allowed:+$allowed, }$site"; fi
  done <<EOF
$(consent_rows 2>/dev/null || true)
EOF
  say "info  sites the agent may use: ${allowed:-none} (./jobhunter browser sites; login check: ./jobhunter browser check)"
  check "chat channel" oc channels status --probe
  if out="$(oc config get skills.workshop.autonomous.mode 2>/dev/null)" && printf '%s' "$out" | grep -q auto; then
    say "FAIL  Skill Workshop autonomous mode is auto: OpenClaw runs every agent weekly to rewrite its skills."
    say "      Run: openclaw${JH_OC_PROFILE:+ --profile $JH_OC_PROFILE} config set skills.workshop.autonomous.mode propose"
    bad=1
  fi
  if out="$(oc config get plugins.entries.memory-core --json 2>/dev/null)" && printf '%s' "$out" | grep -qi dreaming; then
    say "WARN  memory dreaming is configured; make sure it does not target jobhunter-* agents."
  fi
  if [ "$bad" = "1" ]; then say "doctor: some checks failed (see docs/TROUBLESHOOTING.md)"; return 1; fi
  say "doctor: all checks passed"
}

cmd_update() {
  need_home
  local before="" after="" head0="" head1=""
  git -C "$REPO" rev-parse --git-dir >/dev/null 2>&1 \
    || die "this folder is not a git clone, so ./jobhunter update cannot download a new version (README, Updating)"
  before="$(cksum <"$REPO/sheets/Code.gs" 2>/dev/null || true)"
  head0="$(git -C "$REPO" rev-parse HEAD 2>/dev/null || true)"
  say "[1/3] Downloading the new version (git pull)"
  git -C "$REPO" pull --ff-only \
    || die "the download failed; nothing was changed. If git says local changes would be overwritten, see which files you changed with: git -C $REPO status (git -C $REPO stash puts your changes aside), then ./jobhunter update again. Without internet, try again later"
  head1="$(git -C "$REPO" rev-parse HEAD 2>/dev/null || true)"
  if [ "$head0" = "$head1" ]; then say "already the newest version; the installer runs anyway to check your setup"; fi
  # the identity checks run again only when a version changed (install.sh probe stamp); the model route of the
  # first install is kept (recorded in private/home.json)
  say "[2/3] Running the installer again (your data, PIN, site consents and settings stay as they are)"
  "$REPO/install.sh" "$@" \
    || die "the new version is downloaded, but the installer stopped (see the lines above). Fix that, then run ./install.sh again"
  say "[3/3] Self test"
  "$PY" "$JH" --human selftest --offline || die "the self test failed after the update; run ./jobhunter doctor"
  after="$(cksum <"$REPO/sheets/Code.gs" 2>/dev/null || true)"
  if [ "$before" != "$after" ]; then
    say "sheets/Code.gs changed: paste it into Apps Script and redeploy (docs/GOOGLE-SHEETS.md, \"Updating the script later\")."
  fi
  say "update complete"
}

# ------------------------------------------------------------------ init wizard (design 8)
wizard_step() { printf '\n== %s\n' "$1"; }
ask_line() {  # ask_line <prompt> -> REPLY_LINE
  REPLY_LINE=""
  printf '%s' "$1"
  IFS= read -r REPLY_LINE || REPLY_LINE=""
}
REPLY_LINE=""

# The guard's owner fallback and the failure alerts are rendered from owner.notify (design 1.4, 10.3 step 10
# and 13). The installer ran before the wizard set a real number, so apply both again now.
apply_owner_target() {
  local p="" lines="" line="" n=0
  if p="$("$PY" "$JH" --human install render-guard-config 2>&1)" && oc config patch --file "$p" >/dev/null 2>&1; then
    oc plugins reload jobhunter-guard >/dev/null 2>&1 || true
    say "the guard now knows your chat number"
  else
    say "NOTE: the guard config was not updated; run ./install.sh again later so owner messages reach you"
  fi
  lines="$("$PY" "$JH" --human install render-crons --alerts 2>/dev/null)" || lines=""
  while IFS= read -r line <&3; do
    [ -n "$line" ] || continue
    eval "set -- $line"
    [ "${1:-}" = "cron" ] || continue
    if oc "$@" >/dev/null 2>&1; then n=$((n + 1)); fi
  done 3<<LINES
$lines
LINES
  say "failure alerts: $n"
}

wizard_owner() {  # name, Gmail address, signature and chat number in private/config.json (owner.*)
  local missing="" out=""
  local -a args=()
  missing="$("$PY" "$JH" --human install owner --missing 2>&1)" || die "$missing"
  if [ -z "$missing" ]; then say "SKIP your details are set (owner in private/config.json)"; return 0; fi
  say "These go into private/config.json (never committed): your name signs every email, the Gmail address is"
  say "the one email is sent from, and the chat number is where drafts and alerts reach you."
  case "$missing" in *first_name*|*last_name*)
    ask_line 'Your first name: '; args+=(--first-name "$REPLY_LINE")
    ask_line 'Your last name: '; args+=(--last-name "$REPLY_LINE")
    ask_line 'Phone number for your email signature (Enter for none): '; args+=(--phone "$REPLY_LINE") ;;
  esac
  case "$missing" in *gmail_address*)
    ask_line 'The Gmail address you send from: '; args+=(--gmail "$REPLY_LINE") ;;
  esac
  case "$missing" in *first_name*|*signature_links*)
    ask_line 'Links for your signature, full https:// addresses separated by spaces (Enter for none): '
    if [ -z "$REPLY_LINE" ]; then args+=(--no-links); else
      local l=""
      local -a parts=()
      read -r -a parts <<<"$REPLY_LINE" || true
      for l in ${parts[@]+"${parts[@]}"}; do args+=(--link "$l"); done
    fi ;;
  esac
  case "$missing" in *notify*)
    say "Notifications and approvals in chat (read docs/SAFETY-AND-TOS.md; a separate number is recommended)."
    ask_line 'Chat app: whatsapp, telegram or none [whatsapp]: '
    local chan="${REPLY_LINE:-whatsapp}"
    args+=(--notify-channel "$chan")
    if [ "$chan" != "none" ]; then
      ask_line "Your $chan number or address (numbers in international form: + country code, then the number): "
      args+=(--notify-to "$REPLY_LINE")
    fi ;;
  esac
  out="$("$PY" "$JH" --human install owner ${args[@]+"${args[@]}"} 2>&1)" \
    || die "$out (run ./jobhunter init again, or edit owner in private/config.json)"
  say "$out"
  case "$out" in *"chat number changed"*) apply_owner_target ;; esac
}

cmd_init() {
  is_tty || die "the wizard asks you questions, so it needs a terminal: run ./jobhunter init yourself in the Terminal app"
  need_home
  local onb="$REPO/state/onboarding"
  mkdir -p "$onb"

  wizard_step "1. Owner PIN"
  if [ -f "$REPO/private/owner_pin.json" ]; then say "SKIP PIN is set"; else
    say "The owner PIN stays on this computer; it is not an account password. You type it to approve drafts,"
    say "allow sites and raise limits. The agent never knows it, so it cannot approve its own drafts or raise"
    say "its own limits."
    cmd_pin set
  fi

  wizard_step "2. Folders and config"
  "$PY" "$JH" --human init

  wizard_step "3. About you (name, Gmail address, chat number)"
  wizard_owner

  wizard_step "4. Resume"
  local found="" f="" path="" ext=""
  for f in "$REPO"/private/resume/original.*; do
    if [ -f "$f" ]; then found="$f"; fi
  done
  if [ -n "$found" ]; then
    say "SKIP resume imported (${found#$REPO/}); run ./jobhunter profile to change answers"
  else
    printf 'Path to your resume (PDF or DOCX): '
    IFS= read -r path || true
    path="${path/#\~/$HOME}"
    [ -f "$path" ] || die "file not found: $path"
    case "$path" in *.pdf|*.PDF|*.docx|*.DOCX) ;; *) die "use a PDF or DOCX file" ;; esac
    # profile import copies it to private/resume/original.<ext> and extracts the text
    jh_pin profile import --resume "$path"
    say "If the text quality is poor, paste your resume text into private/resume/resume.txt and run this again."
  fi

  wizard_step "5. Extra information"
  if [ ! -f "$REPO/private/extra_info.md" ] && [ -f "$REPO/private.example/extra_info.example.md" ]; then
    cp "$REPO/private.example/extra_info.example.md" "$REPO/private/extra_info.md"
    chmod 600 "$REPO/private/extra_info.md"
  fi
  printf 'Open private/extra_info.md to add projects, numbers, links and tools? [Y/n] '
  local yn=""
  IFS= read -r yn || true
  case "$yn" in n|N|no) say "SKIP extra information" ;; *)
    if [ "$(uname -s)" = "Darwin" ] && [ -z "${EDITOR:-}" ]; then open -W -e "$REPO/private/extra_info.md"
    else "${EDITOR:-vi}" "$REPO/private/extra_info.md"; fi ;;
  esac

  # Steps 6 and 7 run the onboarding automations (restricted OpenClaw runs, through cron_turn). They are done when
  # their files exist (profile status input_files), never because a run exited 0: a run can end without
  # recording anything, and a marker would then skip the step on every re-run.
  wizard_step "6. Salary research (scout, public pages only)"
  if onboard_has salary_research; then say "SKIP salary research recorded"; else
    local titles="" city="" wd="$JH_WS_ROOT/scout/work/onboarding"
    printf 'Job titles you are aiming for (comma separated): '; IFS= read -r titles || true
    printf 'City (or remote): '; IFS= read -r city || true
    mkdir -p "$wd"
    "$PY" -c 'import json,sys; json.dump({"role_titles": [t.strip() for t in sys.argv[1].split(",") if t.strip()], "city": sys.argv[2].strip()}, open(sys.argv[3], "w"), indent=1)' \
      "$titles" "$city" "$wd/salary_inputs.json"
    cron_turn jobhunter:onboard-salary 20m >/dev/null || true
    if onboard_has salary_research; then say "DONE salary research"
    else say "NOTE: the salary research turn recorded nothing; the profile will say model estimate, not verified (./jobhunter init tries again)"; fi
  fi

  wizard_step "7. Profile inference (evaluator)"
  if onboard_has inference && onboard_has base_resume; then say "SKIP profile inferred"; else
    local wd="$JH_WS_ROOT/evaluator/work/onboarding"
    mkdir -p "$wd"
    # profile import and profile salary-record already put resume.txt and salary.json here; the extra
    # information may have been edited after the import
    if [ -f "$REPO/private/resume/resume.txt" ]; then cp "$REPO/private/resume/resume.txt" "$wd/resume.txt"; fi
    if [ -f "$REPO/private/extra_info.md" ]; then cp "$REPO/private/extra_info.md" "$wd/extra_info.md"; fi
    cron_turn jobhunter:onboard-profile 20m >/dev/null || true
    if ! onboard_has inference || ! onboard_has base_resume; then
      die "profile inference recorded nothing (no private/profile_inference.json or private/resume/base.json); run ./jobhunter init again (docs/TROUBLESHOOTING.md, First run wizard)"
    fi
    say "DONE profile inferred"
  fi

  wizard_step "8. Your preferences (interview)"
  jh_pin profile interview

  wizard_step "9. Feasibility check"
  jh profile feasibility || true

  wizard_step "10. Base resume"
  jh_pin resume base-review
  jh resume base-build

  wizard_step "11. Sites the agent may use (your Chrome logins, asked per site)"
  # Before any cookie is copied: the plain explanation, one question per site (default No), your choice of
  # Chrome profile, then the copy of only those sites and a read-only login check.
  browser_consent --new || say "NOTE: run ./jobhunter browser consent later"

  wizard_step "12. Email"
  local mstate=""
  mstate="$("$PY" "$JH" --human install mail-state 2>/dev/null)" || mstate=""
  case "$mstate" in
    *route=app_password*)
      if "$PY" "$JH" mail test >/dev/null 2>&1; then say "SKIP mail is connected (app password route)"; else
        say "You picked the optional app password route (gmail.route = app_password, docs/EMAIL-SETUP.md)."
        jh_pin mail connect || say "NOTE: run ./jobhunter mail connect later"
      fi ;;
    *)
      say "Email is sent from your own Gmail inside the agent's browser (gmail.route = web_ui, the default)."
      say "No password is needed. Every email still passes QC, your approval mode and the Gmail limits."
      if site_allowed gmail; then say "Gmail: allowed (the login check is above)"
      else say "Gmail is not allowed, so no email is sent. Allow it any time: ./jobhunter browser consent gmail"; fi
      say "Optional instead: a Google app password (docs/EMAIL-SETUP.md), only if you want code to send over SMTP." ;;
  esac
  say "LinkedIn stays off unless you run ./jobhunter linkedin enable (read docs/SAFETY-AND-TOS.md first)."

  wizard_step "13. History and exclusions"
  if [ ! -f "$REPO/private/exclusions.csv" ] && [ -f "$REPO/private.example/exclusions.example.csv" ]; then
    cp "$REPO/private.example/exclusions.example.csv" "$REPO/private/exclusions.csv"; chmod 600 "$REPO/private/exclusions.csv"
  fi
  say "Add people and companies you already contacted to private/exclusions.csv (see the examples in it)."
  if [ ! -f "$onb/history.done" ]; then
    printf 'Import your sent emails of the last 365 days so nobody is contacted twice? [Y/n] '
    IFS= read -r yn || true
    case "$yn" in n|N|no) say "SKIP history import" ;; *)
      if jh_pin mail import-history --days 365; then : >"$onb/history.done"; fi ;;
    esac
  fi

  wizard_step "14. Google Sheet"
  if "$PY" "$JH" sheet ping >/dev/null 2>&1; then say "SKIP sheet is connected"; else
    say "One click in your own Google account is needed here: when you run the Job Hunter script in YOUR sheet,"
    say "Google shows an Allow screen once, so the script may edit that sheet. No other account access is given."
    say "Follow docs/GOOGLE-SHEETS.md steps 1 to 4, then paste the web app URL and the secret."
    printf 'Open a new Google Sheet (sheets.new) in your own Chrome now? [Y/n] '
    IFS= read -r yn || yn=""
    case "$yn" in n|N|no) ;; *)
      if [ "$(uname -s)" = "Darwin" ]; then
        open -a "Google Chrome" "https://sheets.new" >/dev/null 2>&1 || open "https://sheets.new" >/dev/null 2>&1 \
          || say "Open https://sheets.new in your browser."
      else
        xdg-open "https://sheets.new" >/dev/null 2>&1 || say "Open https://sheets.new in your browser."
      fi ;;
    esac
    jh_pin sheet connect || say "NOTE: run ./jobhunter sheet connect later"
  fi

  wizard_step "15. Check and go live"
  cmd_doctor || true
  say "When every check is ok: ./jobhunter resume"
}

# ------------------------------------------------------------------ dispatch
# The commands above have their own steps (typed sentences, notes, cron switches, the editor). Everything else
# is a jh.py command that a person may run, passed through run_jh (PIN when it needs the owner).
cmd="${1:-help}"
[ $# -gt 0 ] && shift
case "$cmd" in
  help|-h|--help) usage ;;
  status) cmd_status ;;
  inbox) need_home; jh inbox ;;
  pause) cmd_pause "$@" ;;
  resume|unpause) cmd_resume "$@" ;;
  stop-now) cmd_stop_now ;;
  run) cmd_run "$@" ;;
  logs) cmd_logs "$@" ;;
  approve) [ $# -ge 1 ] || die "usage: ./jobhunter approve <code>"; jh_pin approve "$1" --by cli ;;
  skip)
    [ $# -ge 1 ] || die "usage: ./jobhunter skip <code> [reason]"
    code="$1"; shift
    if [ "${1:-}" = "--reason" ]; then shift; fi
    if [ $# -gt 0 ]; then jh_pin skip "$code" --reason "$*"; else jh_pin skip "$code"; fi ;;
  edit) cmd_edit "$@" ;;
  init) cmd_init ;;
  profile)
    if [ $# -eq 0 ]; then need_home; jh_pin profile interview; jh profile feasibility || true
    else run_jh profile "$@"; fi ;;
  pin) cmd_pin "$@" ;;
  mail)
    sub="${1:-}"
    [ $# -gt 0 ] && shift
    case "$sub" in
      connect) jh_pin mail connect "$@" ;;
      test) jh mail test "$@" ;;
      "") die "usage: ./jobhunter mail connect [--store file] | mail test | mail import-history --days <n>" ;;
      *) run_jh mail "$sub" "$@" ;;
    esac ;;
  sheet)
    sub="${1:-}"
    [ $# -gt 0 ] && shift
    case "$sub" in
      connect) jh_pin sheet connect "$@" ;;
      sync) jh sheet sync "$@" ;;
      "") die "usage: ./jobhunter sheet connect | sheet sync [--full] | sheet ping" ;;
      *) run_jh sheet "$sub" "$@" ;;
    esac ;;
  browser) cmd_browser "$@" ;;
  enrich)
    # optional email finder (docs/EMAIL-FINDER.md): keys and paid-tier lookups are owner actions (PIN)
    sub="${1:-}"
    case "$sub" in
      connect)
        is_tty || die "enrich connect needs a terminal: you type the key yourself, with the echo off"
        need_home; jh_pin enrich "$@" ;;
      disconnect|retry|test) need_home; jh_pin enrich "$@" ;;
      find)
        case " $* " in *" --i"*) need_home; jh_pin enrich "$@" ;; *) run_jh enrich "$@" ;; esac ;;
      "") die "usage: ./jobhunter enrich connect <provider> | disconnect <provider>|--all | budget | show <contact> | retry <contact> | test <provider>" ;;
      *) run_jh enrich "$@" ;;
    esac ;;
  linkedin) cmd_linkedin "$@" ;;
  config)
    case "${1:-}" in
      lower) [ $# -eq 3 ] || die "usage: ./jobhunter config lower <dotted.path> <value>"; jh config lower "$2" "$3" ;;
      raise) [ $# -eq 3 ] || die "usage: ./jobhunter config raise <dotted.path> <value>"; jh_pin config raise "$2" "$3" ;;
      "") die "usage: ./jobhunter config lower|raise <dotted.path> <value> | config validate | config show" ;;
      *) run_jh config "$@" ;;
    esac ;;
  approval)
    if [ "${1:-}" = "set" ]; then shift; fi
    cmd_approval "$@" ;;
  tier)
    if [ "${1:-}" = "set" ]; then shift; fi
    case "${1:-}" in
      --platform|--platform=*|--tier|--tier=*) jh_pin tier set "$@" ;;
      *) [ $# -eq 2 ] || die "usage: ./jobhunter tier set gmail|linkedin conservative|moderate (PIN)"
         jh_pin tier set --platform "$1" --tier "$2" ;;
    esac ;;
  breaker)
    if [ "${1:-}" = "reset" ] && [ $# -eq 2 ]; then
      printf 'Why is it safe to reset %s now? ' "$2"
      note=""; IFS= read -r note || true
      [ -n "$note" ] || die "a note is required"
      jh_pin breaker reset --scope "$2" --note "$note"
    else
      run_jh breaker "$@"
    fi ;;
  reconcile)
    if [ "${1:-}" = "not-sent" ]; then
      [ $# -eq 2 ] || die "usage: ./jobhunter reconcile not-sent <token>"
      jh_pin reconcile confirm-not-sent "$2"
    else
      run_jh reconcile "$@"
    fi ;;
  exclusions)
    if [ "${1:-}" = "deactivate" ]; then jh_pin exclusions import --deactivate; else run_jh exclusions "$@"; fi ;;
  approvals)
    if [ $# -eq 0 ]; then run_jh approvals list; else run_jh approvals "$@"; fi ;;
  forget)
    [ $# -eq 2 ] || die "usage: ./jobhunter forget --email <address> | --linkedin <url> | --contact <id>"
    jh_pin forget "$1" "$2" ;;
  doctor) cmd_doctor "$@" ;;
  update) cmd_update "$@" ;;
  uninstall) exec "$REPO/uninstall.sh" "$@" ;;
  *)
    if [ "$JH_HOME_EXISTS" != "1" ]; then usage >&2; die "unknown command: $cmd"; fi
    run_jh "$cmd" "$@" ;;
esac
