{
  "$comment": "Reviewer verdict (writing-qc 9.4) plus the echoed nonce and draft_sha256 (design 5.3). Parsed strictly by scripts/jobhunter/qc/review.py: unknown keys or missing fields mean FAIL.",
  "type": "object",
  "required": ["nonce", "draft_sha256", "verdict", "gates", "scores", "weighted_score", "claims", "hook", "ai_tells",
               "issues", "rewrite_brief", "confidence"],
  "additionalProperties": false,
  "properties": {
    "nonce": {"type": "string"},
    "draft_sha256": {"type": "string"},
    "verdict": {"enum": ["pass", "fail"]},
    "gates": {"type": "object", "additionalProperties": false,
      "required": ["truthful", "hook_verified", "swap_test", "no_ai_voice", "safe"],
      "properties": {"truthful": {"type": "boolean"}, "hook_verified": {"type": "boolean"},
                     "swap_test": {"type": "boolean"}, "no_ai_voice": {"type": "boolean"}, "safe": {"type": "boolean"}}},
    "scores": {"type": "object", "additionalProperties": false,
      "required": ["specificity", "value", "human_voice", "clarity", "cta", "tone_fit", "channel_fit"],
      "properties": {"specificity": {"type": "integer", "minimum": 1, "maximum": 5},
                     "value": {"type": "integer", "minimum": 1, "maximum": 5},
                     "human_voice": {"type": "integer", "minimum": 1, "maximum": 5},
                     "clarity": {"type": "integer", "minimum": 1, "maximum": 5},
                     "cta": {"type": "integer", "minimum": 1, "maximum": 5},
                     "tone_fit": {"type": "integer", "minimum": 1, "maximum": 5},
                     "channel_fit": {"type": "integer", "minimum": 1, "maximum": 5}}},
    "weighted_score": {"type": "number", "minimum": 1, "maximum": 5},
    "claims": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["quote", "fact_id", "supported"],
      "properties": {"quote": {"type": "string"}, "fact_id": {"type": ["string", "null"]},
                     "supported": {"type": "boolean"}, "note": {"type": "string"}}}},
    "hook": {"type": "object", "additionalProperties": false, "required": ["quote", "fact_id", "accurate"],
      "properties": {"quote": {"type": "string"}, "fact_id": {"type": ["string", "null"]},
                     "accurate": {"type": "boolean"}, "note": {"type": "string"}}},
    "ai_tells": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["quote", "pattern"],
      "properties": {"quote": {"type": "string"}, "pattern": {"type": "string"}}}},
    "issues": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["severity", "quote", "problem", "fix"],
      "properties": {"severity": {"enum": ["blocker", "major", "minor"]}, "quote": {"type": "string"},
                     "problem": {"type": "string"}, "fix": {"type": "string"}}}},
    "rewrite_brief": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
