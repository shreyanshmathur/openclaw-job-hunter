{
  "description": "Recorded fake applier cycle (fictional company and person): an approved application package submitted on a Greenhouse form, following the jobhunter-gate, jobhunter-apply-ats and jobhunter-upload skills. Browser calls are recorded in the shapes the jobhunter-guard plugin accepts: act kinds with refs from the latest snapshot of the same tab, upload with paths and a ref, drivers as act kind evaluate whose fn is the exact driver file text ({DRIVER:<name>} stands for the text of drivers/<name>.js).",
  "agent": "jobhunter-applier",
  "lane": "applier",
  "fields": [{"label": "First Name", "value": "Alex"}, {"label": "Last Name", "value": "Rivera"}, {"label": "Email", "value": "alex.rivera@example.com"}, {"label": "Notice period (days)", "value": "30"}, {"label": "I agree to the privacy notice", "value": "true"}],
  "resume": "Alex_Rivera_Resume.pdf",
  "steps": [
    {"tool": "exec", "params": {"command": "{PY} {REPO}/scripts/jh.py preflight --lane applier", "timeoutSeconds": 90}},
    {"tool": "exec", "params": {"command": "{PY} {REPO}/scripts/jh.py --cycle {CYCLE} apply next --limit 1", "timeoutSeconds": 90}},
    {"tool": "browser", "params": {"profile": "jobhunter", "action": "navigate", "targetUrl": "https://job-boards.greenhouse.io/example/jobs/1"}},
    {"tool": "browser", "params": {"profile": "jobhunter", "action": "act", "kind": "evaluate", "fn": "{DRIVER:detect_page}"}, "result": {"detect_file": {"platform": "greenhouse", "url": "https://job-boards.greenhouse.io/example/jobs/1", "title": "Data Analyst at Kestrel Commerce", "http_status": null, "text": "Data Analyst Apply for this job"}, "hint": "clear", "matched": [], "family": "ats"}},
    {"tool": "write", "params": {"path": "{WS}/work/{CYCLE}/detect-1.json", "content_from": "last_result.detect_file"}},
    {"tool": "exec", "params": {"command": "{PY} {REPO}/scripts/jh.py detect --file {WS}/work/{CYCLE}/detect-1.json", "timeoutSeconds": 90}},
    {"tool": "exec", "params": {"command": "{PY} {REPO}/scripts/jh.py gate precheck-plan --kind application --job {JOB}", "timeoutSeconds": 90}},
    {"tool": "browser", "params": {"profile": "jobhunter", "action": "act", "kind": "evaluate", "fn": "{DRIVER:read_applied_state}"}, "result": {"checks": [{"name": "applied_badge", "value": false}, {"name": "already_applied_text", "value": false}], "matched": [], "page_url": "https://job-boards.greenhouse.io/example/jobs/1"}},
    {"tool": "write", "params": {"path": "{WS}/work/{CYCLE}/precheck.json", "content": {"kind": "application", "platform": "greenhouse", "observed_at": "{NOW}", "page_url": "https://job-boards.greenhouse.io/example/jobs/1", "checks": [{"name": "applied_badge", "value": false}, {"name": "already_applied_text", "value": false}]}}},
    {"tool": "exec", "params": {"command": "{PY} {REPO}/scripts/jh.py gate precheck --kind application --platform greenhouse --job {JOB} --file {WS}/work/{CYCLE}/precheck.json", "timeoutSeconds": 90}},
    {"tool": "exec", "params": {"command": "{PY} {REPO}/scripts/jh.py gate reserve --kind application --draft {DRAFT} --precheck {PRECHECK} --platform greenhouse --job {JOB}", "timeoutSeconds": 90}},
    {"tool": "exec", "params": {"command": "{PY} {REPO}/scripts/jh.py resume stage --variant {VARIANT} --token {TOKEN}", "timeoutSeconds": 90}},
    {"tool": "browser", "params": {"profile": "jobhunter", "action": "snapshot"}, "result": "- heading \"Data Analyst\" [level=1] [ref=e2]\n- button \"Apply for this job\" [ref=e10]"},
    {"tool": "browser", "params": {"profile": "jobhunter", "action": "act", "kind": "click", "ref": "e10"}},
    {"tool": "browser", "params": {"profile": "jobhunter", "action": "snapshot"}, "result": "- form \"Apply for this job\" [ref=e11]\n  - button \"Attach\" [ref=e12]\n  - textbox \"First Name\" [ref=e20]\n  - textbox \"Last Name\" [ref=e21]\n  - textbox \"Email\" [ref=e22]\n  - textbox \"Notice period (days)\" [ref=e23]\n  - checkbox \"I agree to the privacy notice\" [ref=e25]\n  - button \"Submit application\" [ref=e30]"},
    {"tool": "browser", "params": {"profile": "jobhunter", "action": "upload", "paths": ["{UPLOAD}"], "ref": "e12"}},
    {"tool": "browser", "params": {"profile": "jobhunter", "action": "act", "kind": "type", "ref": "e20", "text": "Alex", "slowly": true}},
    {"tool": "browser", "params": {"profile": "jobhunter", "action": "act", "kind": "type", "ref": "e21", "text": "Rivera", "slowly": true}},
    {"tool": "browser", "params": {"profile": "jobhunter", "action": "act", "kind": "type", "ref": "e22", "text": "alex.rivera@example.com", "slowly": true}},
    {"tool": "browser", "params": {"profile": "jobhunter", "action": "act", "kind": "type", "ref": "e23", "text": "30", "slowly": true}},
    {"tool": "browser", "params": {"profile": "jobhunter", "action": "act", "kind": "click", "ref": "e25"}},
    {"tool": "browser", "params": {"profile": "jobhunter", "action": "act", "kind": "evaluate", "fn": "{DRIVER:read_form}"}, "result": {"observed": {"fields": "{FIELDS}", "resume_filename_visible": "Alex_Rivera_Resume.pdf"}, "required_empty": [], "captcha_visible": false, "account_wall": false, "validation_errors": []}},
    {"tool": "write", "params": {"path": "{WS}/work/{CYCLE}/observed-{TOKEN}.json", "content_from": "last_result.observed"}},
    {"tool": "exec", "params": {"command": "{PY} {REPO}/scripts/jh.py gate arm {TOKEN} --observed-file {WS}/work/{CYCLE}/observed-{TOKEN}.json", "timeoutSeconds": 90}},
    {"tool": "exec", "params": {"command": "{PY} {REPO}/scripts/jh.py pace wait --platform greenhouse --kind dwell", "timeoutSeconds": 90}},
    {"tool": "browser", "params": {"profile": "jobhunter", "action": "act", "kind": "click", "ref": "e30"}},
    {"tool": "browser", "params": {"profile": "jobhunter", "action": "act", "kind": "evaluate", "fn": "{DRIVER:read_toast}"}, "result": {"toasts": [], "success_phrases": ["thank(s| you) for applying"], "error_phrases": [], "page_error_phrases": []}},
    {"tool": "write", "params": {"path": "{WS}/work/{CYCLE}/evidence-{TOKEN}.txt", "content": "Page: Thank you for applying to Kestrel Commerce."}},
    {"tool": "exec", "params": {"command": "{PY} {REPO}/scripts/jh.py gate confirm {TOKEN} --evidence-file {WS}/work/{CYCLE}/evidence-{TOKEN}.txt", "timeoutSeconds": 90}},
    {"tool": "exec", "params": {"command": "{PY} {REPO}/scripts/jh.py resume unstage --token {TOKEN}", "timeoutSeconds": 90}},
    {"tool": "browser", "params": {"profile": "jobhunter", "action": "close"}},
    {"tool": "exec", "params": {"command": "{PY} {REPO}/scripts/jh.py cycle end --cycle {CYCLE}", "timeoutSeconds": 90}}
  ]
}
