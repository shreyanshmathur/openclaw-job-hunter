{
  "description": "Recorded fake outreach cycle (fictional people): LinkedIn invitation with a note, following the jobhunter-gate and jobhunter-linkedin skills. Placeholders in braces are filled by the replay. Browser calls are recorded in the shapes the jobhunter-guard plugin accepts: act kinds with refs from the latest snapshot of the same tab, upload with paths and a ref, drivers as act kind evaluate whose fn is the exact driver file text ({DRIVER:<name>} stands for the text of drivers/<name>.js).",
  "agent": "jobhunter-outreach",
  "lane": "outreach",
  "note": "Hi Alex, your post on pincode-level return models matched my work on COD risk scoring at Tidemark Logistics. Glad to connect.",
  "steps": [
    {"tool": "exec", "params": {"command": "{PY} {REPO}/scripts/jh.py preflight --lane outreach", "timeoutSeconds": 90}},
    {"tool": "exec", "params": {"command": "{PY} {REPO}/scripts/jh.py --cycle {CYCLE} outreach next --limit 2", "timeoutSeconds": 90}},
    {"tool": "browser", "params": {"profile": "jobhunter", "action": "navigate", "targetUrl": "https://www.linkedin.com/in/example-alex-rivera/"}},
    {"tool": "exec", "params": {"command": "{PY} {REPO}/scripts/jh.py usage add --platform linkedin --metric profile_view", "timeoutSeconds": 90}},
    {"tool": "browser", "params": {"profile": "jobhunter", "action": "act", "kind": "evaluate", "fn": "{DRIVER:detect_page}"}, "result": {"detect_file": {"platform": "linkedin", "url": "https://www.linkedin.com/in/example-alex-rivera/", "title": "Alex Rivera | LinkedIn", "http_status": null, "text": "Alex Rivera Head of Analytics at Kestrel Commerce 2nd Connect Message More"}, "hint": "clear", "matched": [], "family": "linkedin"}},
    {"tool": "write", "params": {"path": "{WS}/work/{CYCLE}/detect-1.json", "content_from": "last_result.detect_file"}},
    {"tool": "exec", "params": {"command": "{PY} {REPO}/scripts/jh.py detect --file {WS}/work/{CYCLE}/detect-1.json", "timeoutSeconds": 90}},
    {"tool": "exec", "params": {"command": "{PY} {REPO}/scripts/jh.py gate precheck-plan --kind li_invite --contact {CONTACT}", "timeoutSeconds": 90}},
    {"tool": "browser", "params": {"profile": "jobhunter", "action": "act", "kind": "evaluate", "fn": "{DRIVER:read_li_invite_dialog}"}, "result": {"page_url": "https://www.linkedin.com/in/example-alex-rivera/", "dialog_open": false, "note_box_present": false, "note_text": null, "profile": {"name": "Alex Rivera", "vanity_slug": "example-alex-rivera", "degree": "2nd", "primary_button": "Connect", "more_menu_has_connect": false, "open_to_work": false}}},
    {"tool": "write", "params": {"path": "{WS}/work/{CYCLE}/precheck.json", "content": {"kind": "li_invite", "platform": "linkedin", "observed_at": "{NOW}", "page_url": "https://www.linkedin.com/in/example-alex-rivera/", "checks": [{"name": "profile_button", "value": "Connect"}, {"name": "vanity_slug", "value": "example-alex-rivera"}]}}},
    {"tool": "exec", "params": {"command": "{PY} {REPO}/scripts/jh.py gate precheck --kind li_invite --platform linkedin --contact {CONTACT} --file {WS}/work/{CYCLE}/precheck.json", "timeoutSeconds": 90}},
    {"tool": "exec", "params": {"command": "{PY} {REPO}/scripts/jh.py gate reserve --kind li_invite --draft {DRAFT} --precheck {PRECHECK} --platform linkedin --contact {CONTACT}", "timeoutSeconds": 90}},
    {"tool": "browser", "params": {"profile": "jobhunter", "action": "snapshot"}, "result": "- heading \"Alex Rivera\" [level=1] [ref=e20]\n- button \"Connect\" [ref=e31]\n- button \"Message\" [ref=e32]\n- button \"More\" [ref=e33]"},
    {"tool": "browser", "params": {"profile": "jobhunter", "action": "act", "kind": "click", "ref": "e31"}},
    {"tool": "browser", "params": {"profile": "jobhunter", "action": "snapshot"}, "result": "- dialog \"Add a note to your invitation?\" [ref=e40]\n  - button \"Add a note\" [ref=e44]\n  - button \"Send without a note\" [ref=e46]"},
    {"tool": "browser", "params": {"profile": "jobhunter", "action": "act", "kind": "click", "ref": "e44"}},
    {"tool": "browser", "params": {"profile": "jobhunter", "action": "snapshot"}, "result": "- dialog \"Add a note to your invitation?\" [ref=e40]\n  - textbox \"Add a note\" [ref=e45]\n  - button \"Send\" [ref=e47]"},
    {"tool": "browser", "params": {"profile": "jobhunter", "action": "act", "kind": "type", "ref": "e45", "text": "{NOTE}", "slowly": true}},
    {"tool": "browser", "params": {"profile": "jobhunter", "action": "act", "kind": "evaluate", "fn": "{DRIVER:read_li_invite_dialog}"}, "result": {"dialog_open": true, "note_box_present": true, "note_text": "{NOTE}", "note_max": 200, "send_button": {"present": true, "enabled": true}, "email_required": false, "limit_notice": false}},
    {"tool": "write", "params": {"path": "{WS}/work/{CYCLE}/observed-{TOKEN}.txt", "content_from": "last_result.note_text"}},
    {"tool": "exec", "params": {"command": "{PY} {REPO}/scripts/jh.py gate arm {TOKEN} --observed-file {WS}/work/{CYCLE}/observed-{TOKEN}.txt", "timeoutSeconds": 90}},
    {"tool": "exec", "params": {"command": "{PY} {REPO}/scripts/jh.py pace wait --platform linkedin --kind dwell", "timeoutSeconds": 90}},
    {"tool": "browser", "params": {"profile": "jobhunter", "action": "act", "kind": "click", "ref": "e47"}},
    {"tool": "browser", "params": {"profile": "jobhunter", "action": "act", "kind": "evaluate", "fn": "{DRIVER:read_toast}"}, "result": {"toasts": ["Your invitation to Alex Rivera was sent."], "success_phrases": ["invitation sent"], "error_phrases": [], "page_error_phrases": []}},
    {"tool": "browser", "params": {"profile": "jobhunter", "action": "act", "kind": "evaluate", "fn": "{DRIVER:detect_page}"}, "result": {"detect_file": {"platform": "linkedin", "url": "https://www.linkedin.com/in/example-alex-rivera/", "title": "Alex Rivera | LinkedIn", "http_status": null, "text": "Alex Rivera Pending"}, "hint": "clear", "matched": [], "family": "linkedin"}},
    {"tool": "write", "params": {"path": "{WS}/work/{CYCLE}/evidence-{TOKEN}.txt", "content": "Toast: Your invitation to Alex Rivera was sent."}},
    {"tool": "exec", "params": {"command": "{PY} {REPO}/scripts/jh.py gate confirm {TOKEN} --evidence-file {WS}/work/{CYCLE}/evidence-{TOKEN}.txt", "timeoutSeconds": 90}},
    {"tool": "browser", "params": {"profile": "jobhunter", "action": "close"}},
    {"tool": "exec", "params": {"command": "{PY} {REPO}/scripts/jh.py cycle end --cycle {CYCLE}", "timeoutSeconds": 90}}
  ]
}
